# ================================================================
# M-Real Estate — Environment Variables
# ================================================================
# Copy file này thành .env.local và điền thông tin thực tế
# cp .env.local.example .env.local

# ----------------------------------------------------------------
# PRISMA / DATABASE (Supabase PostgreSQL)
# Lấy tại: Supabase Dashboard → Settings → Database → Connection string
#
# Dùng "Direct Connection" (port 5432) cho Prisma migrate/push:
# ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Dùng "Transaction Pooler" (port 6543) khi deploy serverless (Vercel):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----------------------------------------------------------------
# SUPABASE (JS Client — dùng cho Storage, Realtime nếu cần)
# Lấy tại: https://supabase.com/dashboard/project/<your-project>/settings/api
# ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ----------------------------------------------------------------
# GOOGLE GEMINI API
# Lấy tại: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ----------------------------------------------------------------
# ADMIN DASHBOARD
# Mật khẩu đăng nhập trang /admin (Basic Auth)
# ----------------------------------------------------------------
ADMIN_PASSWORD=your-secure-admin-password

# ----------------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=M-Real Estate
