generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  new
  contacted
  advised
  completed
  cancelled
}

enum LeadStatus {
  new
  contacted
  advised
  completed
  cancelled
  done
}

enum FurnishingStatus {
  DEVELOPER_HANDOVER
  BASIC_FURNISHED
  FULLY_FURNISHED
}

enum AdminRole {
  master
  admin
  telesale
  staff
}

// ─── Core models ─────────────────────────────────────────────────────────────

model RentalListing {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectCode     String           @map("project_code") @db.VarChar
  unitCode        String           @map("unit_code") @db.VarChar
  areaSqm         Decimal          @map("area_sqm") @db.Decimal
  bedrooms        Int
  bathrooms       Int
  furnishingStatus FurnishingStatus @default(FULLY_FURNISHED) @map("furnishing_status")
  furnishingNote  String?          @map("furnishing_note") @db.Text
  view            String?          @db.Text
  rentPrice       Decimal          @map("rent_price") @db.Decimal
  displayPrice    String           @default("") @map("display_price") @db.Text
  availability    String?          @db.Text
  sourceName      String?          @map("source_name") @db.VarChar
  note            String?          @db.Text
  imagePaths      String[]         @default([]) @map("image_paths")
  isVisible       Boolean          @default(true) @map("is_visible")
  isFeatured      Boolean          @default(false) @map("is_featured")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([projectCode, unitCode], map: "rental_listings_project_unit_unique")
  @@map("rental_listings")
}

model SaleListing {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectCode     String           @map("project_code") @db.VarChar
  unitCode        String           @map("unit_code") @db.VarChar
  areaSqm         Decimal          @map("area_sqm") @db.Decimal
  bedrooms        Int
  bathrooms       Int
  furnishingStatus FurnishingStatus @default(DEVELOPER_HANDOVER) @map("furnishing_status")
  furnishingNote  String?          @map("furnishing_note") @db.Text
  view            String?          @db.Text
  contractPrice   Decimal?         @map("contract_price") @db.Decimal
  sellingPrice    Decimal          @map("selling_price") @db.Decimal
  displayPrice    String           @default("") @map("display_price") @db.Text
  availability    String?          @db.Text
  sourceName      String?          @map("source_name") @db.VarChar
  note            String?          @db.Text
  imagePaths      String[]         @default([]) @map("image_paths")
  isVisible       Boolean          @default(true) @map("is_visible")
  isFeatured      Boolean          @default(false) @map("is_featured")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("sale_listings")
}

model NewsPost {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  slug          String    @unique
  excerpt       String?
  content       String?
  thumbnailPath String?   @map("thumbnail_path")
  imagePaths    String[]  @default([]) @map("image_paths")
  featured      Boolean   @default(false)
  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at")
  seoTitle      String?   @map("seo_title")
  seoDescription String?  @map("seo_description")
  tags          String[]  @default([])
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("news_posts")
}

// ─── CRM / Leads ─────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  fullName        String            @map("full_name")
  phone           String
  need            String?
  budget          String?
  appointmentTime String?           @map("appointment_time")
  contactMethod   String?           @map("contact_method")
  source          String?
  status          AppointmentStatus @default(new)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("appointments")
}

model ChatbotLead {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String?    @map("full_name")
  phone           String?
  need            String?
  area            String?
  budget          String?
  bedrooms        String?
  neededTime      String?    @map("needed_time")
  purpose         String?
  appointmentTime String?    @map("appointment_time")
  contactMethod   String?    @map("contact_method")
  conversation    Json?
  status          LeadStatus @default(new)
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@map("chatbot_leads")
}

model Contact {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String    @map("full_name")
  phone       String
  email       String?
  message     String?
  status      String    @default("new")
  contactedAt DateTime? @map("contacted_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("contacts")
}

model Staff {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  role       String
  phone      String
  zalo       String?
  initials   String
  image      String?
  color      String
  speciality String?
  order      Int      @default(0)
  deletedAt  DateTime? @map("deleted_at")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("staff")
}

model AdminProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  phone        String?
  role         AdminRole @default(staff)
  permissions  String[]  @default([])
  position     String?
  specialty    String?
  avatarUrl    String?   @map("avatar_url")
  initials     String?
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_profiles")
}
